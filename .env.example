# =============================================================================
# Variables de entorno para docker compose / ejecucion local.
#
# Copiar a ".env" (ignorado por git) y completar. NINGUN valor de este fichero
# debe llegar al control de versiones: aqui solo hay nombres y ejemplos.
# =============================================================================

# --- Seguridad --------------------------------------------------------------
# Secreto del cliente OAuth2 "pedidos-gateway" (client_credentials).
AUTH_CLIENT_SECRET_GATEWAY=cambiar-este-secreto

# Contrasena del usuario de la consola web (authorization_code + PKCE).
AUTH_USUARIO_PASSWORD=cambiar-esta-contrasena

# Token del proveedor logistico. Lo exige el proveedor; el servicio falla en el
# arranque si no esta presente (nunca se escribe en el codigo fuente).
PROVEEDOR_LOGISTICO_TOKEN=cambiar-este-token

# Clave simetrica de cifrado JCE del servidor de configuracion (cualquier cadena larga y aleatoria).
# Generar con: openssl rand -base64 32
CONFIG_ENCRYPT_KEY=

# --- Base de datos ----------------------------------------------------------
POSTGRES_PASSWORD=cambiar-esta-contrasena

# --- Otros ------------------------------------------------------------------
AUTH_UI_REDIRECT_URI=http://localhost:8080/index.html
